# Password per entrare in /admin
ADMIN_PASSWORD=cambiami
# Segreto per firmare i cookie (stringa lunga casuale)
AUTH_SECRET=cambiami-con-una-stringa-lunga

# Neon Postgres (se assente, in locale usa PGlite in .data/)
# DATABASE_URL=postgres://user:pass@host/db?sslmode=require
# Cartella per il database locale PGlite (default: temp di sistema)
# PGLITE_DIR=.data/pglite

# Ably per il tempo reale (se assente, i client fanno polling ogni 1.5 s)
# ABLY_API_KEY=xxxx.yyyy:zzzz
